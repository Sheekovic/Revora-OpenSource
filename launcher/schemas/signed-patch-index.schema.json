{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playrevora.com/schemas/signed-patch-index.schema.json",
  "title": "PlayRevora signed patch index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indexId", "channel", "issuedAtUtc", "expiresAtUtc", "patches", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "indexId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "channel": { "enum": ["production", "owner-test"] },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } },
    "signature": { "$ref": "signed-client-manifest.schema.json#/$defs/signature" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["patchId", "sourceVersion", "targetVersion", "metadataPath"],
      "properties": {
        "patchId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "sourceVersion": { "$ref": "#/$defs/version" }, "targetVersion": { "$ref": "#/$defs/version" },
        "metadataPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
