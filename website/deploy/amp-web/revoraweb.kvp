Meta.DisplayName=Revora Web
Meta.Description=Revora bilingual web platform
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=x86_64
Meta.Author=Revora Project
Meta.URL=https://playrevora.com
Meta.DisplayImageSource=none:
Meta.EndpointURIFormat=http://127.0.0.1:{{$WebPort}}
Meta.ConfigManifest=revorawebconfig.json
Meta.MetaConfigManifest=revorawebmetaconfig.json
Meta.ConfigRoot=revoraweb.kvp
Meta.MinAMPVersion=2.8.0.4
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Revora Web supports AMP-managed rootless containers with loopback-only application binding and no elevation.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Private development template; updates and automatic restart are disabled.
Meta.AppConfigId=9b2e6f22-01c7-4c60-8cb6-7c6b43d2f94f
App.DisplayName=Revora Web
App.RootDir=./revora-web/
App.BaseDirectory=./revora-web/app/
App.ExecutableLinux=app/Revora.Web
App.WorkingDir=app
App.CommandLineArgs=--config config/revora-web.json
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=stop
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=127.0.0.1
App.Ports=@IncludeJson[revorawebports.json]
App.PrimaryApplicationPortRef=WebPort
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[revorawebupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=No trusted Revora Web release source exists yet.
App.Compatibility=None
App.RapidStartup=False
App.SmartExcludeExemptions=["config/*.json"]
App.SmartExcludeSupported=True
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^\[Revora.Web\] READY$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.AutoRetryCount=0
