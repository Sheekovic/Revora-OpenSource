#!/bin/sh
set -eu
umask 077

backup_dir=/var/backups/revora-postgresql
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
temporary=$(mktemp "$backup_dir/.revora-$timestamp.XXXXXX.dump")
final="$backup_dir/revora-$timestamp.dump"

cleanup() {
    if [ -f "$temporary" ]; then
        rm -f -- "$temporary"
    fi
}
trap cleanup EXIT HUP INT TERM

pg_dump --dbname=revora --format=custom --no-owner --no-privileges --file="$temporary"
chmod 0600 "$temporary"
mv -- "$temporary" "$final"
sha256sum "$final" > "$final.sha256"
chmod 0600 "$final.sha256"

find "$backup_dir" -maxdepth 1 -type f -name 'revora-*.dump' -mtime +13 -delete
find "$backup_dir" -maxdepth 1 -type f -name 'revora-*.dump.sha256' -mtime +13 -delete
