<Window x:Class="Revora.ClientDoctor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revora Client Doctor" Width="920" Height="640" MinWidth="720" MinHeight="520" Background="#0B1018" Foreground="#F2E8D5">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="REVORA CLIENT DOCTOR" FontSize="30" FontWeight="SemiBold" Foreground="#D9AD63"/><TextBlock Text="Safe legacy-client inventory / فحص آمن لملفات العميل القديم" FontSize="15" Margin="0,6,0,24" Foreground="#AEB8C6"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourcePath" Height="38" Padding="10" VerticalContentAlignment="Center" ToolTip="Select a local legacy client folder"/><Button Grid.Column="1" Content="Select folder / اختر المجلد" Margin="12,0,0,0" Padding="18,7" Click="SelectFolder"/></Grid>
    <StackPanel Grid.Row="2" Margin="0,18"><StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="Scan read-only / فحص للقراءة فقط" Padding="20,9" Click="Scan"/><Button x:Name="BuildButton" Content="Build clean client / إنشاء عميل نظيف" Padding="20,9" Margin="10,0,0,0" IsEnabled="False" Click="Build"/><Button x:Name="CancelButton" Content="Cancel / إلغاء" Padding="20,9" Margin="10,0,0,0" IsEnabled="False" Click="Cancel"/><TextBlock x:Name="StateText" Text="Blocked: no source selected / متوقف" Margin="20,9" Foreground="#E2B86F"/></StackPanel><ProgressBar x:Name="BuildProgress" Height="8" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="0"/><TextBlock x:Name="ProgressText" Margin="0,7,0,0" Foreground="#93A2B6" Text="No build active"/></StackPanel>
    <TextBox Grid.Row="3" x:Name="Results" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111A27" Foreground="#DDE5EE" BorderBrush="#28364A" Padding="14" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="4" Margin="0,16,0,0" Foreground="#93A2B6" Text="Test 2 constructs a separate verified tree. It never launches or modifies the donor."/>
  </Grid>
</Window>
