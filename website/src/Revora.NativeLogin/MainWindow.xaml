<Window x:Class="Revora.NativeLogin.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revora Native Login — Owner Test 3" Width="720" Height="650" Background="#0B1018" Foreground="#F2E7D0">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Revora Native Login"/><TextBlock Margin="0,6,0,20" Foreground="#B8C0CC" Text="Private Owner Test 3 · no Flash · no injection · loopback only"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="Verified Test 2c client folder"/><DockPanel Margin="0,6,0,12"><Button DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Click="Browse">Browse</Button><TextBox x:Name="ClientPath" IsReadOnly="True" Padding="8"/></DockPanel></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="PrepareButton" Width="180" Height="38" Click="Prepare">Prepare Test 3 copy</Button><Button x:Name="CancelButton" Width="100" Height="38" Margin="10,0" Click="Cancel" IsEnabled="False">Cancel</Button><ProgressBar x:Name="Progress" Width="250" Height="18"/></StackPanel>
    <Border Grid.Row="3" Margin="0,18,0,12" Padding="14" BorderBrush="#3B4657" BorderThickness="1" CornerRadius="5"><TextBlock x:Name="Status" TextWrapping="Wrap" Text="Select the verified Test 2c output. Preparation never modifies or launches that folder."/></Border>
    <Grid Grid.Row="4" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Game account"/><TextBox x:Name="Username" MaxLength="16" Padding="8"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Password"/><PasswordBox x:Name="Password" MaxLength="16" Padding="8"/></StackPanel></Grid>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12"><Button x:Name="StartButton" Width="180" Height="40" Click="StartClient" IsEnabled="False">Start exact client</Button><Button x:Name="SendButton" Width="160" Height="40" Margin="10,0" Click="SendLogin" IsEnabled="False">Send native login</Button><Button x:Name="StopButton" Width="130" Height="40" Click="EmergencyStop" IsEnabled="False" Background="#7A2630" Foreground="White">Emergency Stop</Button></StackPanel>
    <TextBlock Grid.Row="6" Foreground="#AEB8C8" TextWrapping="Wrap" Text="The first run targets only 127.0.0.1:9958. The probe records packet length/type and state only—never credential or packet payload bytes. If the client cannot cross the proven native boundary without Flash, the report will say so and no compatibility claim will be made."/>
    <TextBlock Grid.Row="7" Foreground="#7F8A99" Text="Client execution always requires your explicit click. Close this window to stop the helper."/>
  </Grid>
</Window>
