  <ItemGroup>
    <ProjectReference Include="../Revora.NativeLogin.Core/Revora.NativeLogin.Core.csproj" />
    <ProjectReference Include="../Revora.Launcher.Core/Revora.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
