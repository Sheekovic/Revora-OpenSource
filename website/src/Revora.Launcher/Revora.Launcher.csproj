<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Revora.Launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/revora.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Product>Revora Launcher</Product>
    <Company>Revora</Company>
    <Description>Revora Launcher and Client Repair</Description>
    <Copyright>Revora</Copyright>
    <Version>1.0.8</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Revora.Launcher.Core/Revora.Launcher.Core.csproj" />
    <Compile Include="../Revora.NativeLogin.Core/ConfigurationOnlyPatchAudit5165.cs" Link="M1Core/ConfigurationOnlyPatchAudit5165.cs" />
    <Compile Include="../Revora.NativeLogin.Core/OwnerTestReportWriter.cs" Link="M1Core/OwnerTestReportWriter.cs" />
    <Compile Include="../Revora.NativeLogin.Core/OwnerTestWorkspace.cs" Link="M1Core/OwnerTestWorkspace.cs" />
    <Compile Include="../Revora.NativeLogin.Core/Test3Preparation.cs" Link="M1Core/Test3Preparation.cs" />
    <Resource Include="Assets/revora.ico" />
    <Resource Include="../Revora.Web/wwwroot/assets/revora-full-logo.png" Link="Assets/revora-full-logo.png" />
    <Resource Include="../Revora.Web/wwwroot/assets/revora-guardian.png" Link="Assets/revora-guardian.png" />
  </ItemGroup>
</Project>
