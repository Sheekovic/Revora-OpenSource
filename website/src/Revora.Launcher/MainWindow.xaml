<Window x:Class="Revora.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Revora Launcher" Width="1280" Height="760" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#080D15" Foreground="#F4F6FA" Icon="Assets/revora.ico" Loaded="WindowLoaded" StateChanged="WindowStateChanged">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid x:Name="RootGrid" ClipToBounds="True">
    <Image Source="Assets/revora-guardian.png" Stretch="UniformToFill" Opacity="0.52" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.67,0.36" GradientOrigin="0.67,0.36" RadiusX="0.75" RadiusY="0.78"><GradientStop Color="#224BA2D9" Offset="0"/><GradientStop Color="#B20A111C" Offset="0.63"/><GradientStop Color="#FA060A10" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
    <Canvas x:Name="MotionLayer" IsHitTestVisible="False" Opacity="0.46">
      <Ellipse Width="620" Height="180" Canvas.Left="-140" Canvas.Top="190"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5576A8CE"/><GradientStop Color="#0076A8CE" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="FogOne"/></Ellipse.RenderTransform></Ellipse>
      <Ellipse Width="780" Height="220" Canvas.Right="-250" Canvas.Top="380"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#335F7990"/><GradientStop Color="#005F7990" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><TranslateTransform x:Name="FogTwo"/></Ellipse.RenderTransform></Ellipse>
      <Ellipse Width="4" Height="4" Fill="#F0C26B" Canvas.Left="260" Canvas.Top="470"/><Ellipse Width="3" Height="3" Fill="#9DD4FF" Canvas.Left="470" Canvas.Top="290"/><Ellipse Width="5" Height="5" Fill="#D99E45" Canvas.Left="820" Canvas.Top="430"/><Ellipse Width="2" Height="2" Fill="#E9CA88" Canvas.Left="980" Canvas.Top="220"/>
    </Canvas>
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#C40A1019" BorderBrush="#443C5268" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBarDrag">
        <Grid Margin="14,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/revora.ico" Width="26" Height="26"/><TextBlock Text="R E V O R A" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource GlassButton}" Width="48" Height="36" Padding="0" Margin="0,6,2,6" Content="—" Click="MinimizeWindow" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource GlassButton}" Width="48" Height="36" Padding="0" Margin="0,6,8,6" Content="✕" Click="CloseWindow" AutomationProperties.Name="Close"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="32,22,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,28,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650"><Border Width="310" Height="220"><Image Source="Assets/revora-full-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border><TextBlock x:Name="HeroStatus" Text="Preparing your journey" FontSize="18" Foreground="#D7E5F3" HorizontalAlignment="Center" Margin="0,-22,0,0"/><TextBlock Text="A world restored with care. A new legend begins." Foreground="#91A4B8" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
          <Border Grid.Row="1" Background="{StaticResource PanelSoft}" BorderBrush="#554D667C" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ANNOUNCEMENT" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Revora client integrity and repair services" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Signed releases · recoverable updates · verified game launch" Foreground="#A9B6C5" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SERVER" Foreground="#8093A7" FontSize="10"/><TextBlock x:Name="ServerStatusText" Text="Checking…" Foreground="#7FD7A4" FontWeight="SemiBold"/></StackPanel></Grid></Border>
        </Grid>
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#75536D84" BorderThickness="1" CornerRadius="18" Padding="24">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PanelHeading" Text="Client status" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="OperationText" Text="Starting secure launcher…" Foreground="#AAB9C9" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="LanguageButton" Style="{StaticResource GlassButton}" Content="العربية" Click="ToggleLanguage" AutomationProperties.Name="Switch language"/></Grid>
            <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LOCAL" Foreground="#74879B" FontSize="10"/><TextBlock x:Name="LocalVersionText" Text="Unknown"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="AVAILABLE" Foreground="#74879B" FontSize="10"/><TextBlock x:Name="RemoteVersionText" Text="Checking…"/></StackPanel></Grid>
            <StackPanel Grid.Row="2" Margin="0,20,0,0"><ProgressBar x:Name="TotalProgress" Height="8" Minimum="0" Maximum="1" Value="0" Background="#263342" Foreground="{StaticResource Blue}" BorderThickness="0"/><TextBlock x:Name="ProgressPercent" Text="0%" HorizontalAlignment="Right" Margin="0,6,0,0" Foreground="#A9B7C6"/><TextBlock x:Name="CurrentFileText" Text="No file operation" Foreground="#8294A7" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TransferText" Text="0 B / 0 B" Foreground="#8294A7"/><TextBlock Grid.Column="1" x:Name="SpeedText" Text="—" Foreground="#8294A7"/></Grid></StackPanel>
            <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,18,0,0"><Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="Please wait" Click="PrimaryAction" AutomationProperties.Name="Primary launcher action"/><WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0"><Button x:Name="PauseButton" Style="{StaticResource GlassButton}" Content="Pause" Click="PauseResume" IsEnabled="False" Margin="3"/><Button x:Name="FullRepairButton" Style="{StaticResource GlassButton}" Content="Full Repair" Click="FullRepair" Margin="3"/><Button x:Name="SettingsButton" Style="{StaticResource GlassButton}" Content="Settings" Click="Settings" Margin="3"/><Button x:Name="FolderButton" Style="{StaticResource GlassButton}" Content="Open Folder" Click="OpenFolder" Margin="3"/><Button x:Name="DiagnosticsButton" Style="{StaticResource GlassButton}" Content="Diagnostics" Click="ExportDiagnostics" Margin="3"/><Button x:Name="OpenDiagnosticsButton" Style="{StaticResource GlassButton}" Content="Open Diagnostics Folder" Click="OpenDiagnosticsFolder" Margin="3" IsEnabled="False"/></WrapPanel></StackPanel>
            <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LauncherVersionText" Foreground="#65788C" FontSize="11"/><TextBlock Grid.Column="1" x:Name="PingText" Text="Ping —" Foreground="#65788C" FontSize="11"/></Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#D0080D14" BorderBrush="#333E5062" BorderThickness="0,1,0,0"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="#72869A" Text="Signed desired state · recoverable updates · verified game launch"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#72869A" Text="playrevora.com"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
