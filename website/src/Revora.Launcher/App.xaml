<Application x:Class="Revora.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="GoldColor">#E6BD69</Color><Color x:Key="BlueColor">#67AEEB</Color>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/><SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="Panel" Color="#CC101825"/><SolidColorBrush x:Key="PanelSoft" Color="#99151F2D"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style>
    <Style TargetType="Button" x:Key="GlassButton">
      <Setter Property="Foreground" Value="#EAF1F9"/><Setter Property="Background" Value="#441E2C3C"/><Setter Property="BorderBrush" Value="#665F7792"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#77405A76"/><Setter TargetName="Shell" Property="BorderBrush" Value="#AA8DB8DE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource GlassButton}"><Setter Property="Foreground" Value="#0A111B"/><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="BorderBrush" Value="#FFF0C98A"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="26,13"/></Style>
  </Application.Resources>
</Application>
