<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version><AssemblyTitle>Revora Client Endpoint</AssemblyTitle><Company>Revora</Company>
    <Description>Configure the account endpoint of approved 6711 DX9 clients with backup and restore.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevoraRelease)' == 'true'"><TargetFramework>net10.0-windows</TargetFramework></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Revora.ClientEndpoint.Core.csproj" /></ItemGroup>
  <Target Name="ExportRuntimePackPaths" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true' and '$(RevoraRelease)' == 'true'">
    <WriteLinesToFile File="$(PublishDir)runtime-pack-paths.txt" Lines="@(ResolvedRuntimePack->'%(PackageDirectory)')" Overwrite="true" />
  </Target>
</Project>
